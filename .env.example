NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL="file:./federation-dev.db"
# Обход ошибки движка Prisma 6 при создании SQLite в некоторых средах.
RUST_LOG=info
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Владелец создаётся интерактивно: npm run user:create
# Как в RioCar: heartbeat каждые 30 сек, простой 2 минуты, абсолютный срок 4 часа.
SESSION_IDLE_MINUTES=2
SESSION_HOURS=4
# За reverse proxy с HTTPS: NODE_ENV=production и TRUST_PROXY=loopback

# На сервере после настройки DNS и HTTPS:
# APP_ORIGIN=https://kickboxing19.ru
# Не меняйте существующий DATABASE_URL при смене домена.

# Индексация включается только на production с APP_ORIGIN=https://kickboxing19.ru
SEO_INDEXABLE=false
# Необязательные публичные коды подтверждения владения из кабинетов поисковиков:
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
