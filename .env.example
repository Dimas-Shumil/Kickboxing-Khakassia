NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL="file:./federation-dev.db"
# Обход ошибки движка Prisma 6 при создании SQLite в некоторых средах.
RUST_LOG=info
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Владелец создаётся интерактивно: npm run user:create
# Как в RioCar: heartbeat каждые 30 сек, простой 2 минуты, абсолютный срок 4 часа.
SESSION_IDLE_MINUTES=2
SESSION_HOURS=4
# За reverse proxy с HTTPS: NODE_ENV=production и TRUST_PROXY=loopback
