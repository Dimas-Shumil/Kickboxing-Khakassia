<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Вход — Федерация кикбоксинга Хакасии</title><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@400;500;600&display=swap" rel="stylesheet"><link rel="stylesheet" href="/site/css/admin.min.css"></head>
<body class="admin"><main class="login-layout"><div class="login-brand"><img src="/site/img/logo-fed.png" alt="Логотип Федерации"><h1>Федерация кикбоксинга Хакасии</h1><p>Управление сайтом и залом</p></div><div class="panel login-panel"><h2>Вход в управление</h2><p class="form-note">Для владельца и редактора</p><% if(error){ %><div class="notice notice--error" role="alert"><%= error %></div><% } %><form method="post" action="/admin/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Логин<input name="login" value="<%= login %>" autocomplete="username" required maxlength="100" autofocus></label><label>Пароль<input type="password" name="password" autocomplete="current-password" required maxlength="256"></label><button class="btn btn--primary" type="submit">Войти</button></form><p class="form-note"><a href="/public/index.html">Вернуться на сайт</a></p></div></main></body></html>
