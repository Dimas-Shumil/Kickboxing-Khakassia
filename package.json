{
  "name": "kickboxing-federation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "sass site/sass/main.scss site/css/main.css --no-source-map --style=expanded && sass site/sass/main.scss site/css/main.min.css --no-source-map --style=compressed",
    "watch:css": "sass --watch site/sass/main.scss:site/css/main.min.css --no-source-map --style=compressed",
    "setup:local": "node tools/setup-local.cjs",
    "user:create": "node tools/create-user.cjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "build:admin": "sass site/sass/admin.scss site/css/admin.css --no-source-map --style=expanded && sass site/sass/admin.scss site/css/admin.min.css --no-source-map --style=compressed",
    "test": "node --test --test-concurrency=1 tests/server.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "sass": "^1.93.0"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
