generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  login        String   @unique
  name         String
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  @@map("User")
}

// Таблица прежних express-session не используется; сохраняется для безопасного обновления.
model LegacySession {
  sid     String   @id
  data    String
  expires DateTime
  @@index([expires])
  @@map("Session")
}

model Student {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  parent    String   @default("")
  start     String
  group     String   @default("")
  trainer   String   @default("")
  price     Int
  status    String
  note      String   @default("")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments  Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  student   String
  pupil     Student  @relation(fields: [student], references: [id], onDelete: Restrict)
  amount    Int
  received  String
  period    String
  comment   String   @default("")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions PaymentRevision[]
  @@index([received])
  @@index([student, period])
}

model PaymentRevision {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  before    String
  reason    String
  actorId   String
  createdAt DateTime @default(now())
}

model News {
  slug String? @unique
  publishedPayload String?
  publishedOn DateTime?
  assets NewsAsset[]
  id        String   @id @default(cuid())
  title     String
  status    String   @default("draft")
  payload   String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  scope     String
  entityId  String
  action    String
  createdAt DateTime @default(now())
  @@index([scope, createdAt])
}

model AdminSession {
  id            String @id @default(cuid())
  adminId       String
  tokenHash     String @unique
  csrfTokenHash String
  expiresAt     DateTime
  lastUsedAt    DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  admin         Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId])
  @@index([expiresAt])
}

model NewsAsset {
  id String @id
  newsId String
  news News @relation(fields: [newsId], references: [id], onDelete: Restrict)
  size Int
  createdAt DateTime @default(now())
}

// Публичные биографии не связаны с приватными учениками и оплатами.
model Person {
 id String @id @default(cuid())
 name String
 status String @default("draft")
 payload String
 publishedPayload String?
 slug String? @unique
 version Int @default(1)
 publishedOn DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 assets PersonAsset[]
}
model PersonAsset {
 id String @id
 personId String
 person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
 size Int
 createdAt DateTime @default(now())
}

model Competition {
 id String @id @default(cuid())
 title String
 status String @default("draft")
 payload String
 publishedPayload String?
 slug String? @unique
 version Int @default(1)
 publishedOn DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 assets CompetitionAsset[]
}
model CompetitionAsset {
 id String @id
 competitionId String
 competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
 size Int
 kind String
 createdAt DateTime @default(now())
}
