generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  name         String
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Session {
  sid     String   @id
  data    String
  expires DateTime
  @@index([expires])
}

model Student {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  parent    String   @default("")
  start     String
  group     String   @default("")
  trainer   String   @default("")
  price     Int
  status    String
  note      String   @default("")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments  Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  student   String
  pupil     Student  @relation(fields: [student], references: [id], onDelete: Restrict)
  amount    Int
  received  String
  period    String
  comment   String   @default("")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions PaymentRevision[]
  @@index([received])
  @@index([student, period])
}

model PaymentRevision {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  before    String
  reason    String
  actorId   String
  createdAt DateTime @default(now())
}

model News {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("draft")
  payload   String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  scope     String
  entityId  String
  action    String
  createdAt DateTime @default(now())
  @@index([scope, createdAt])
}
